table fact_deliveries
	lineageTag: 661f2c40-de1e-449d-93f5-cca2489d20bf

	measure 'Total Deliveries' = SUM(fact_deliveries[Estimated_Deliveries])
		formatString: #,0
		displayFolder: 1 Executive Overview
		lineageTag: d1de264b-9d80-43b3-a6fd-3b3664dda99d

	measure 'Total Production' = SUM(fact_deliveries[Production_Units])
		formatString: #,0
		displayFolder: 1 Executive Overview
		lineageTag: 774c01b4-2771-4473-a4b0-2618ee8ffddc

	measure 'Est. Revenue' = SUM(fact_deliveries[Est_Revenue_USD])
		formatString: \$#,0,,"M"
		displayFolder: 1 Executive Overview
		lineageTag: fd183f9f-a515-47d5-ae6f-700e88dafe76

	measure 'Avg Selling Price' = DIVIDE([Est. Revenue], [Total Deliveries])
		formatString: \$#,0
		displayFolder: 1 Executive Overview
		lineageTag: cca2c851-a758-4373-8544-7aee03c2883c

	measure 'Delivery Efficiency' = DIVIDE([Total Deliveries], [Total Production])
		formatString: 0.0%
		displayFolder: 1 Executive Overview
		lineageTag: 40f71529-7f5b-482c-ad67-f346c01cffb6

	measure 'Inventory Gap' = [Total Production] - [Total Deliveries]
		formatString: #,0
		displayFolder: 1 Executive Overview
		lineageTag: 610e0a5e-356b-48bf-a7af-84fae4e68399

	measure 'Est. Revenue (KPI)' = VAR v = SUM(fact_deliveries[Est_Revenue_USD]) RETURN IF(ISBLANK(v), BLANK(), SWITCH(TRUE(), v >= 1E9, FORMAT(v / 1E9, "$#,0.0") & "B", v >= 1E6, FORMAT(v / 1E6, "$#,0.0") & "M", v >= 1E3, FORMAT(v / 1E3, "$#,0.0") & "K", FORMAT(v, "$#,0")))
		displayFolder: 1 Executive Overview
		lineageTag: 976308f7-a6cb-4d40-8759-73968c63c0dc

	measure 'Avg Battery Capacity (kWh)' = AVERAGE(fact_deliveries[Battery_Capacity_kWh])
		formatString: #,0.0" kWh"
		displayFolder: 2 Product & ESG
		lineageTag: 9bb71fe5-be78-4054-b715-b4384b5114d1

	measure 'Avg Driving Range (km)' = AVERAGE(fact_deliveries[Range_km])
		formatString: #,0" km"
		displayFolder: 2 Product & ESG
		lineageTag: 26b71f48-4501-451e-939c-ff8ee8afd8ff

	measure 'Charging Stations' = VAR _LastDate = MAX(fact_deliveries[Date]) RETURN SUMX(VALUES(dim_region[Region]), CALCULATE(AVERAGE(fact_deliveries[Charging_Stations]), fact_deliveries[Date] = _LastDate))
		formatString: #,0
		displayFolder: 2 Product & ESG
		lineageTag: c17f442f-13db-4d2c-9050-4c697df6c230

	measure 'Estimated CO2 Savings (t)' = SUM(fact_deliveries[CO2_Saved_tons])
		formatString: #,0
		displayFolder: 2 Product & ESG
		lineageTag: c80e25d8-2f77-443b-b697-db81384ccaf2

	measure 'Estimated CO2 Savings (KPI)' = VAR v = SUM(fact_deliveries[CO2_Saved_tons]) RETURN IF(ISBLANK(v), BLANK(), SWITCH(TRUE(), v >= 1E9, FORMAT(v / 1E9, "#,0.0") & "B t", v >= 1E6, FORMAT(v / 1E6, "#,0.0") & "M t", v >= 1E3, FORMAT(v / 1E3, "#,0.0") & "K t", FORMAT(v, "#,0") & " t"))
		displayFolder: 2 Product & ESG
		lineageTag: 0cdad850-8485-406c-b356-62a03095e8c0

	measure Records = COUNTROWS(fact_deliveries)
		formatString: #,0
		displayFolder: 2 Product & ESG
		lineageTag: 9a17ba2f-f08a-4e3e-8673-eed66c80cb15

